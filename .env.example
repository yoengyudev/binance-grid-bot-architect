TRADING_ENVIRONMENT=TESTNET
# Experimental hourly BUY gate: disabled by default, Testnet validation only.
# Uses public Mainnet 1h ADX/DMI + ATR-normalized EMA slope; blocks non-range
# or unavailable/stale signals. Does not change SELL targets or hard stops.
GRID_REGIME_FILTER_ENABLED=false
# Feature #2, separate opt-in: taper new LIMIT BUYs above 50% held purchase
# cost; held cost + pending BUYs cannot exceed 75% of allocated capital.
# Experimental Testnet validation only; SELL targets and stops are unchanged.
GRID_INVENTORY_SIZING_ENABLED=false
# Feature #3, separate opt-in: an explicit dollar risk budget for a fresh,
# isolated Testnet ledger. Example amount only; may not fund a five-level grid.
# New entries are sized against modeled loss at the hard stop; the campaign
# exit starts at 80% of this budget. Gaps/slippage can exceed the budget.
GRID_RISK_BUDGET_ENABLED=false
GRID_RISK_BUDGET_USDT=2.00
# Feature #4: range-gated, closed 1h ATR adaptation of future BUY lanes only.
# Requires GRID_REGIME_FILTER_ENABLED=true. Testnet validation only.
# Existing SELL targets/held-lot exits are frozen; four-hour change cooldown.
GRID_AUTO_ATR_ENABLED=false
# Feature #5: unlock a capped BUY episode only after a later confirmed profitable
# ordinary SELL and room for a full replacement order. No profit compounding.
# Experimental Testnet only; all entry gates and the original cap still apply.
GRID_CAPITAL_RECYCLING_ENABLED=false
# Feature #6: explicit planning assumptions, NOT a live account fee quote.
# All five percentages are required when enabled. Examples only, Testnet only.
# Entries must clear fees/buffers and this net return; SELLs/stops stay active.
GRID_FEE_VALIDATION_ENABLED=false
GRID_BUY_FEE_PERCENT=0.10
GRID_SELL_FEE_PERCENT=0.10
GRID_ENTRY_SLIPPAGE_PERCENT=0.05
GRID_EXIT_SLIPPAGE_PERCENT=0.05
GRID_MIN_NET_RETURN_PERCENT=0.05
# Set only the credentials for the selected environment; no key fallback exists.
BINANCE_TESTNET_API_KEY=your_spot_testnet_api_key
BINANCE_TESTNET_API_SECRET=your_spot_testnet_api_secret
# BINANCE_MAINNET_API_KEY=your_spot_mainnet_api_key
# BINANCE_MAINNET_API_SECRET=your_spot_mainnet_api_secret
# GRID_BOT_DB_DIR=/absolute/path/to/state
# Optional GRID_BOT_DB_PATH must end in grid_testnet.sqlite or grid_mainnet.sqlite,
# matching TRADING_ENVIRONMENT. Legacy grid_bot.sqlite3 is never opened.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_destination_chat_id
TELEGRAM_OWNER_CHAT_ID=your_private_chat_id
# Set both values for admin login when the trading bot runs:
# BOT_ADMIN_PASSWORD=choose_a_long_unique_password
# BOT_JWT_SECRET=use_at_least_32_random_characters
# FRONTEND_URL=http://localhost:5173
