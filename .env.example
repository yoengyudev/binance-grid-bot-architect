TRADING_ENVIRONMENT=TESTNET
# Set only the credentials for the selected environment; no key fallback exists.
BINANCE_TESTNET_API_KEY=your_spot_testnet_api_key
BINANCE_TESTNET_API_SECRET=your_spot_testnet_api_secret
# BINANCE_MAINNET_API_KEY=your_spot_mainnet_api_key
# BINANCE_MAINNET_API_SECRET=your_spot_mainnet_api_secret
# GRID_BOT_DB_DIR=/absolute/path/to/state
# Optional GRID_BOT_DB_PATH must end in grid_testnet.sqlite or grid_mainnet.sqlite,
# matching TRADING_ENVIRONMENT. Legacy grid_bot.sqlite3 is never opened.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_OWNER_CHAT_ID=your_private_chat_id
# Set both values for admin login when the trading bot runs:
# BOT_ADMIN_PASSWORD=choose_a_long_unique_password
# BOT_JWT_SECRET=use_at_least_32_random_characters
# FRONTEND_URL=http://localhost:5173
