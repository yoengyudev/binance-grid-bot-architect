TRADING_ENVIRONMENT=MAINNET
BINANCE_MAINNET_API_KEY=REPLACE_ON_SERVER
BINANCE_MAINNET_API_SECRET=REPLACE_ON_SERVER
GRID_BOT_CONFIG_PATH=/var/lib/grid-bot/mainnet/config.json
GRID_BOT_DB_PATH=/var/lib/grid-bot/mainnet/grid_mainnet.sqlite
BOT_API_HOST=127.0.0.1
FRONTEND_URL=https://dashboard.example.com
BOT_ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_LONG_PASSWORD
BOT_JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
TELEGRAM_BOT_TOKEN=REPLACE_ON_SERVER_OR_LEAVE_EMPTY
TELEGRAM_CHAT_ID=REPLACE_ON_SERVER_OR_LEAVE_EMPTY
TELEGRAM_OWNER_CHAT_ID=REPLACE_ON_SERVER_OR_LEAVE_EMPTY
XDG_CACHE_HOME=/var/cache/grid-bot-mainnet
PYTHONDONTWRITEBYTECODE=1
