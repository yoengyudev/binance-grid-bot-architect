[Unit]
Description=SOL trend-following paper trial v1.2.0-paper.1
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/sol-trend-paper/releases/v1.2.0-paper.1
ExecStart=/home/ubuntu/sol-trend-paper/releases/v1.2.0-paper.1/.venv/bin/python trend_main.py --env-file /home/ubuntu/sol-trend-paper/trend-paper.env
Environment=PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 MALLOC_ARENA_MAX=2
Restart=on-failure
RestartSec=95s
TimeoutStopSec=60s
UMask=0077
Nice=5
CPUQuota=30%
MemoryHigh=160M
MemoryMax=220M
TasksMax=32
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/sol-trend-paper/state /home/ubuntu/sol-trend-paper/logs
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
StandardOutput=append:/home/ubuntu/sol-trend-paper/logs/service.stdout.log
StandardError=append:/home/ubuntu/sol-trend-paper/logs/service.stderr.log

[Install]
WantedBy=multi-user.target
