TRADING_ENVIRONMENT=TESTNET
BINANCE_TESTNET_API_KEY=REPLACE_ON_EC2
BINANCE_TESTNET_API_SECRET=REPLACE_ON_EC2

GRID_BOT_DB_DIR=/home/ubuntu/prospective-testnet/state
GRID_BOT_DB_PATH=/home/ubuntu/prospective-testnet/state/grid_testnet.sqlite
GRID_BOT_CONFIG_PATH=/home/ubuntu/prospective-testnet/state/config.json

BOT_API_HOST=127.0.0.1
FRONTEND_URL=https://13-239-48-244.sslip.io
BOT_ADMIN_PASSWORD=REPLACE_WITH_A_NEW_PRIVATE_PASSWORD
BOT_JWT_SECRET=REPLACE_WITH_A_NEW_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
BOT_AUTH_MOCK_ENABLED=0

# Empty disables Telegram. Use a separate destination if enabling run alerts.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_OWNER_CHAT_ID=

XDG_CACHE_HOME=/home/ubuntu/prospective-testnet/cache
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1
TZ=UTC

# Optional experimental bundle: keep disabled for an existing-campaign upgrade.
# Activating all six needs a fresh isolated ledger and reviewed risk/fee inputs.
GRID_REGIME_FILTER_ENABLED=false
GRID_INVENTORY_SIZING_ENABLED=false
GRID_RISK_BUDGET_ENABLED=false
GRID_AUTO_ATR_ENABLED=false
GRID_CAPITAL_RECYCLING_ENABLED=false
GRID_FEE_VALIDATION_ENABLED=false
# See the root .env.example and six policy documents for explicit inputs.
