[Unit]
Description=Prospective Testnet burn-in v1.0.6-production
Wants=network-online.target
After=network-online.target
Conflicts=binance-grid-bot.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/prospective-testnet/releases/v1.0.6-production
EnvironmentFile=/home/ubuntu/prospective-testnet/.env
ExecStartPre=/usr/bin/test -f /home/ubuntu/prospective-testnet/state/grid_testnet.sqlite
ExecStart=/home/ubuntu/prospective-testnet/releases/v1.0.6-production/.venv/bin/python /home/ubuntu/prospective-testnet/releases/v1.0.6-production/main.py --ready
Restart=on-failure
RestartSec=60s
RestartPreventExitStatus=2 130
TimeoutStopSec=60s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
StandardOutput=append:/home/ubuntu/prospective-testnet/logs/engine.stdout.log
StandardError=append:/home/ubuntu/prospective-testnet/logs/engine.stderr.log

[Install]
WantedBy=multi-user.target
